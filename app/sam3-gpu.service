[Unit]
Description=SAM3 GPU Segmentation Studio
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/Project/mlx_sam3
Environment=PATH=__HOME__/.local/share/fnm/aliases/default/bin:__HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=__HOME__
ExecStart=/bin/bash __HOME__/Project/mlx_sam3/app/run.sh --gpu
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sam3-gpu

[Install]
WantedBy=multi-user.target
